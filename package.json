{
  "name": "matrimoney",
  "version": "0.1.0",
  "description": "As finanças do casal num app só de vocês, instalado na sua conta da Cloudflare.",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node -e \"require('fs').mkdirSync('dist/client',{recursive:true})\"",
    "dev": "concurrently -k -n web,api \"vite\" \"wrangler dev --port 8787\"",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "instalar": "core-money-instalar",
    "recuperar-acesso": "core-money-recuperar-acesso",
    "atualizar": "git pull --ff-only && npm ci && npm run instalar"
  },
  "dependencies": {
    "@confinancas/core-money": "github:confinancas/core-money#v0.1.0"
  }
}
