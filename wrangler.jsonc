{
  "$schema": "node_modules/wrangler/config-schema.json",
  // não renomear: as passkeys ficam presas ao endereço (ADR-010)
  "name": "matrimoney",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    // só /api/* executa o Worker; o resto é arquivo estático
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      // marcador: o instalador (npm run instalar) põe o id real no wrangler.instalacao.jsonc, fora do git
      "database_name": "matrimoney-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "node_modules/@confinancas/core-money/migrations"
    }
  ],
  "observability": { "enabled": true }
}
